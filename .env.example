# Copy this file to .env and fill in your values
# Never commit .env to GitHub

# From @BotFather on Telegram
BOT_TOKEN=

# From console.groq.com (free) — handles both LLM and voice transcription
GROQ_API_KEY=

# Your Telegram group chat ID (starts with -100)
# Use @RawDataBot to find it
GROUP_CHAT_ID=

# Telegram user IDs for both learning partners
# Use @userinfobot to find yours
USER1_ID=
USER2_ID=

# Daily reminder time in 24h format
REMINDER_TIME=20:00
